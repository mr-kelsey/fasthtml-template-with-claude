# --- SQLite (read by db.py during `pytest` runs) ---
# Deliberately separate from .env's DB_PATH so the test suite can never truncate real app data.
DB_PATH=data/test.db

# --- Uploaded files (read by db.py during `pytest` runs) ---
# Deliberately separate from .env's UPLOADS_DIR so tests never write into the real uploads folder.
UPLOADS_DIR=data/test_uploads
